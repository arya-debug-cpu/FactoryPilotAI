# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# AI (OpenAI-compatible). Leave empty to use the built-in data-grounded
# answer composer — the assistant still works, it just will not call a model.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Backend
CORS_ALLOW_ORIGINS=*
SEED_ON_STARTUP=true
SEED_RESET=false

# Frontend -> backend proxy target (Next.js rewrites + health check)
API_ORIGIN=http://127.0.0.1:8000
API_PORT=8000
# Set to "true" to stop the frontend from auto-starting the backend
FACTORYPILOT_NO_BACKEND=false
